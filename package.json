{
  "name": "tidy-agent-demo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev --hostname localhost",
    "build": "next build",
    "start": "next start --hostname localhost",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint",
    "format": "prettier --write app lib components config scripts tests \"*.{ts,mjs}\"",
    "audit:deps": "pnpm audit --audit-level=low",
    "test": "node --test tests/regression.cjs",
    "setup:workos": "node scripts/setup-workos.ts"
  },
  "dependencies": {
    "@google/genai": "2.27.0",
    "@workos-inc/authkit-nextjs": "4.5.0",
    "@workos-inc/node": "10.14.0",
    "jose": "6.2.13",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.12.0",
    "eslint-config-next": "16.4.2",
    "prettier": "3.9.9",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0"
  }
}
