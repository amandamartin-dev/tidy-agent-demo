# Development environment only. Never commit real credentials.
WORKOS_API_KEY=
WORKOS_CLIENT_ID=
WORKOS_COOKIE_PASSWORD=
NEXT_PUBLIC_WORKOS_REDIRECT_URI=http://localhost:3000/callback
WORKOS_AGENT_BLUEPRINT_ID=
WORKOS_ORGANIZATION_ID=
# Issuer for agent tokens — copy `issuer` from https://<your-authkit-domain>/.well-known/openid-configuration.
# AuthKit user tokens may carry a different iss, so this is configured separately.
WORKOS_AGENT_ISSUER=
# Optional. Server-side only. Without it the assistant uses the scripted fallback.
# Get one at https://aistudio.google.com/apikey (free tier available).
GEMINI_API_KEY=
